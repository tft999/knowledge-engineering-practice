# Set environment variables in your shell; .env is not loaded automatically.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Comma-separated browser origins accepted by FastAPI.
COOKKG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# OpenAI-compatible chat-completions service. Leave unset to disable GraphRAG answers.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=
